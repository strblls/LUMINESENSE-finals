# ── OCR uses Tesseract.js in the browser — no API key needed ────────
# VISION_API_KEY is only required as a fallback if client-side OCR
# is unavailable (e.g. very old browsers). Most deployments can omit it.

# ── Database (optional — overrides the hardcoded values in db_connect.php) ──
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=luminesense_db

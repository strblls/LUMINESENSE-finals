# ── LumineSense Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — secrets stay local.

# ── Environment ────────────────────────────────────────────────────
# Set to 'production' on the live server
# LUMINESENSE_ENV=development

# ── Database ───────────────────────────────────────────────────────
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=luminesense_db

# ── SMTP (Hostinger) ──────────────────────────────────────────────
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_NAME=LumineSense
# MAIL_FROM_EMAIL=

# ── Tokens ────────────────────────────────────────────────────────
# VALID_ADMIN_CODE=
# DEVICE_TOKEN=
# ESP32_TOKEN=
# ID_ENCRYPTION_KEY=

# ── Microservice URLs (Python) ───────────────────────────────────
# LUMINESENSE_API_URL=http://localhost/LUMINESENSE-finals/api/lights.php
# LUMINESENSE_CLASSROOM_ID=1
# LUMINESENSE_ESP32_IP=http://luminesense.local

# ── Google Cloud Vision API ─────────────────────────────────────────
# VISION_API_KEY=
